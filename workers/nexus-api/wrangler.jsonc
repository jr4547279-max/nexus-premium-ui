{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/",
  "name": "nexus-api-dev",
  "account_id": "4d654fd2fae39e00cc7e5a534cf6d741",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-app-dev",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Staging intentionally has no R2 binding. Add a Nexus-only bucket and set
  // ALLOW_UPLOADS=true only after uploads are explicitly enabled later.
  "durable_objects": {
    "bindings": [
      { "name": "CIRCLE_ROOM", "class_name": "CircleRoom" },
      { "name": "LIVE_EVENT_ROOM", "class_name": "CircleRoom" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CircleRoom"] }],
  "vars": {
    "APP_ORIGIN": "https://nexus-web-dev.jayrusss98.workers.dev",
    "PUBLIC_APP_URL": "https://nexus-web-dev.jayrusss98.workers.dev",
    "AUTH_MODE": "production",
    "ALLOW_DEV_AUTH": "false",
    "ALLOW_UPLOADS": "false",
    "EMAIL_API_URL": "https://api.resend.com/emails"
  }
}
