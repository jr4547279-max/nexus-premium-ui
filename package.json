{
  "name": "nexus-premium-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "cd nexus-premium-ui && next dev -H 0.0.0.0 -p 3000",
    "build": "cd nexus-premium-ui && next build && rm -rf ../.next && cp -R .next ../.next",
    "start": "cd nexus-premium-ui && next start -H 0.0.0.0 -p 3000",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./scripts\" --if-present run typecheck"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
