# Local-only Nexus Worker origin. Leave empty when Next and the API share an origin.
NEXT_PUBLIC_NEXUS_API_URL=http://127.0.0.1:39187

# Keyless OpenStreetMap/MapLibre defaults; these do not enable Google billing APIs.
NEXUS_VENUE_PROVIDER=openstreetmap
NEXUS_GEOCODER_PROVIDER=photon
# Map style URL must be compatible with MapLibre; Google Maps needs its own SDK adapter.
NEXT_PUBLIC_NEXUS_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Optional Google adapters remain disabled unless explicitly configured.
# NEXUS_VENUE_PROVIDER=google
# NEXUS_GEOCODER_PROVIDER=google
# GOOGLE_PLACES_API_KEY=
